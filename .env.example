# ClaimPilot Phase 1 — Environment Variables
# Copy to .env and fill in values from Bicep deployment outputs.

# Azure AI Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_MODEL_ID=prebuilt-document

# Azure Speech
AZURE_SPEECH_ENDPOINT=https://<resource>.api.cognitive.microsoft.com/

# Azure Content Understanding (REST)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/api/

# Azure Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=eastus2

# Azure AI Search / Foundry IQ
AZURE_SEARCH_ENDPOINT=https://<resource>.search.windows.net

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/

# Azure Blob Storage
AZURE_STORAGE_ENDPOINT=https://<account>.blob.core.windows.net/

# Azure Service Bus
AZURE_SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net

# Azure SignalR
AZURE_SIGNALR_CONNECTION_STRING=

# Azure Key Vault
AZURE_KEY_VAULT_ENDPOINT=https://<vault>.vault.azure.net/

# Azure AI Foundry (Phase 2+)
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<workspace>.services.ai.azure.com/api/
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-4

# Agent IDs (Phase 2+)
CLASSIFIER_AGENT_ID=
EXTRACTOR_AGENT_ID=
FRAUD_AGENT_ID=
DECISION_AGENT_ID=
