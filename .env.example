# ClaimPilot — Environment Variables
# Copy to .env and fill in values from Bicep deployment outputs.

# ─── Claim Mode ───────────────────────────────────────────────────
# 0 = live agents (real Azure calls), 1 = demo stubs (no Azure needed)
CLAIMPILOT_USE_STUBS=0

# ─── Azure AI Document Intelligence ───────────────────────────────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_MODEL_ID=prebuilt-layout

# ─── Azure Speech ─────────────────────────────────────────────────
AZURE_SPEECH_ENDPOINT=https://<resource>.api.cognitive.microsoft.com/

# ─── Azure Content Understanding (REST) ───────────────────────────
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/api/
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=claimpilot-damage-analyzer

# Image analysis provider: content_understanding | foundry_vision | disabled
IMAGE_ANALYSIS_PROVIDER=content_understanding

# ─── Azure Translator ─────────────────────────────────────────────
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=eastus2

# ─── Azure AI Search / Foundry IQ ─────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<resource>.search.windows.net

# ─── Azure Cosmos DB ──────────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/

# ─── Azure Blob Storage ───────────────────────────────────────────
AZURE_STORAGE_ENDPOINT=https://<account>.blob.core.windows.net/
AZURE_STORAGE_CONNECTION_STRING=

# ─── Azure Service Bus ────────────────────────────────────────────
AZURE_SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net
AZURE_SERVICE_BUS_QUEUE=claims-pipeline

# ─── Azure SignalR ────────────────────────────────────────────────
AZURE_SIGNALR_CONNECTION=

# ─── Azure Key Vault ──────────────────────────────────────────────
AZURE_KEY_VAULT_ENDPOINT=https://<vault>.vault.azure.net/

# ─── Azure AI Foundry ─────────────────────────────────────────────
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<workspace>.cognitiveservices.azure.com/
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# ─── Agent IDs (created by scripts/setup_foundry_agents.py) ───────
CLASSIFIER_AGENT_ID=
EXTRACTOR_AGENT_ID=
FRAUD_AGENT_ID=
DECISION_AGENT_ID=

# ─── Azure Voice Live (Phase 4 — optional) ────────────────────────
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_VERSION=2025-10-01
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_VOICE=alloy
VOICE_LIVE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_LIVE_TRANSCRIPTION_LANGUAGE=en-US
VOICE_LIVE_ENABLE_MCP=false
VOICE_LIVE_MCP_SERVER_URL=
ADJUSTER_SESSION_TOKEN_SECRET=dev-secret-change-in-prod

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
